# Google OAuth credentials — from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate a value with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OpenRouter — from openrouter.ai > Keys
OPENROUTER_API_KEY=
# Model to use, in OpenRouter's "provider/model" format. Change this to swap models.
OPENROUTER_MODEL=anthropic/claude-opus-4-8

# Supabase — from supabase.com > your project > Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
